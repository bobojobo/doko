# Doko - Doppelkopf WebApp Environment Configuration

# Database Configuration
# For local development with docker-compose PostgreSQL
doko__DB_URL=postgresql+psycopg://postgres:password@db:5432/doko

# Session Configuration
# Session token validity in minutes (default: 12 hours)
doko__SESSION_TOKEN_VALIDITY_MINUTES=720

# Database Reset Configuration
# Whether to reset the database on startup (useful for development)
doko__RESET_DB_ON_STARTUP=True

# Test Setup Configuration
# Whether to set up test data on startup
doko__DB_TEST_SETUP=True

# Logging Configuration
# Debug level for application logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
doko__DEBUG_LEVEL=DEBUG
